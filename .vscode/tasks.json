{
    "version": "2.0.0",
    "tasks": [
        {
            "dependsOn": [ "Build plugin" ],
            "type": "shell",
            "label": "Start server",
            "options": {
                "cwd": "${workspaceFolder}/run"
            },
            "command": "${config:runtime.javaJBR}${/}bin${/}java",
            "args": [
                "-XX:+AllowEnhancedClassRedefinition",
                "-XX:HotswapAgent=core",
                "-agentlib:jdwp=transport=dt_socket,server=y,suspend=n,address=8080",
                "-jar", "${config:runtime.serverJar}", "nogui"
            ],
            "problemMatcher": []
        },
        {
            "hide": true,
            "type": "shell",
            "label": "Build plugin",
            "options": {
                "cwd": "${workspaceFolder}"
            },
            "command": "mvn",
            "args": [ "clean", "package" ],
            "problemMatcher": []
        },
    ]
}
